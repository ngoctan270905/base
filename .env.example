# Copy this file to .env and fill values for your environment.
# Expo exposes variables prefixed with EXPO_PUBLIC_ to the client app.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://api.example.com

# Add non-public secrets only to server-side tooling, never to the mobile client bundle.
# Do not put private API keys, database passwords, or signing secrets here.
